    test "{{ confirmation }}" = "reset-{{ environment }}" || { echo "Run: just reset-services reset-{{ environment }}" >&2; exit 1; }
    {{ ansible_playbook }} playbooks/50-reset-services.yml --ask-vault-pass -e target_environment={{ environment }} -e confirm_service_reset=true

# Print the instances selected for destruction; this intentionally fails after listing them.
destroy-plan:
