---
# Generated hosts.yml uses public addresses for SSH and private addresses for
# Kubernetes node traffic. Replace these examples only when provisioning is
# handled outside this repository.
all:
  vars:
    ansible_user: ubuntu
    ansible_ssh_private_key_file: /absolute/path/to/project-02-key
  hosts:
    master01:
      ansible_host: 203.0.113.11
      ip: 10.0.0.11
      access_ip: 10.0.0.11
    master02:
      ansible_host: 203.0.113.12
      ip: 10.0.0.12
      access_ip: 10.0.0.12
    worker01:
      ansible_host: 203.0.113.13
      ip: 10.0.0.13
      access_ip: 10.0.0.13
    worker02:
      ansible_host: 203.0.113.14
      ip: 10.0.0.14
      access_ip: 10.0.0.14
  children:
    kube_control_plane:
      hosts:
        master01:
        master02:
    kube_node:
      hosts:
        master01:
        master02:
        worker01:
        worker02:
    etcd:
      hosts:
        master01:
        master02:
        worker01:
    k8s_cluster:
      children:
        kube_control_plane:
        kube_node:
