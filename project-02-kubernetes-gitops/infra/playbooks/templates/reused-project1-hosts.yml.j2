---
# Generated from Project 01's existing inventory. Do not edit manually.
all:
  vars:
    ansible_user: "{{ project1_inventory.all.vars.ansible_user }}"
    ansible_ssh_private_key_file: "{{ project1_inventory.all.vars.ansible_ssh_private_key_file }}"
    ansible_ssh_common_args: {{ project1_inventory.all.vars.ansible_ssh_common_args | to_json }}
  hosts:
{% for kubernetes_name, project1_name in project1_node_mapping.items() %}
    {{ kubernetes_name }}:
      ansible_host: {{ project1_inventory.all.hosts[project1_name].ansible_host }}
      ip: {{ project1_inventory.all.hosts[project1_name].private_ip }}
      access_ip: {{ project1_inventory.all.hosts[project1_name].private_ip }}
      project1_host: {{ project1_name }}
{% endfor %}
  children:
    kube_control_plane:
      hosts:
        master01:
        master02:
    kube_node:
      hosts:
        master01:
        master02:
        worker01:
        worker02:
    etcd:
      hosts:
        master01:
        master02:
        worker01:
    k8s_cluster:
      children:
        kube_control_plane:
        kube_node:
